# Application
# development | test | production (default: development)
NODE_ENV=development
# HTTP port (default: 3000)
PORT=3000
# Bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pharmacy-db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
# Connection pool tuning (optional; defaults shown)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_MS=5000

# Authentication (required)
# In production this must be at least 32 characters.
JWT_SECRET=YOUR_JWT_SECRET
# Token lifetime: 30m, 1h, 7d, etc. (default: 1h)
JWT_EXPIRY=1h

# CORS
# Comma-separated allowed origins (e.g. http://localhost:3000,https://app.example.com).
# Development: unset reflects any origin.
# Production: unset disables cross-origin requests entirely.
CORS_ORIGIN=

# Swagger UI at /api-docs
# Default: enabled in development, disabled in production.
SWAGGER_ENABLED=

# Rate limiting (optional; defaults shown)
# Global API limit: requests per client per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60
# Stricter limit applied to POST /auth/login.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_TTL=60

# Reverse proxy trust (optional; disabled by default).
# When unset, X-Forwarded-For is ignored and client IP detection
# uses the direct connection address. Configure ONLY behind a
# reverse proxy / load balancer, and only to match the actual
# deployment topology. The trusted proxy must overwrite (not
# append to) client-supplied forwarded headers, otherwise clients
# can spoof their IP to bypass per-IP rate limiting.
# Hop count (1-10), e.g. exactly one proxy in front:
# TRUST_PROXY=1
# Or explicit trusted proxy addresses / CIDR ranges (comma-separated):
# TRUST_PROXY=10.0.0.0/8,192.168.1.10
TRUST_PROXY=
