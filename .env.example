# Application
# development | test | production (default: development)
NODE_ENV=development
# HTTP port (default: 3000)
PORT=3000
# Bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pharmacy-db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
# Connection pool tuning (optional; defaults shown)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_MS=5000

# Authentication (required)
# In production this must be at least 32 characters.
JWT_SECRET=YOUR_JWT_SECRET
# Token lifetime: 30m, 1h, 7d, etc. (default: 1h)
JWT_EXPIRY=1h

# CORS
# Comma-separated allowed origins (e.g. http://localhost:3000,https://app.example.com).
# Development: unset reflects any origin.
# Production: unset disables cross-origin requests entirely.
CORS_ORIGIN=

# Swagger UI at /api-docs
# Default: enabled in development, disabled in production.
SWAGGER_ENABLED=
